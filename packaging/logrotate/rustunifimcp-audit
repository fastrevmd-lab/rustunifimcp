# logrotate fragment for the rustunifimcp JSON audit sink.
#
# Install as /etc/logrotate.d/rustunifimcp-audit (root:root, mode 0644).
# Enable the sink by passing --audit-log-file (or RMCP_AUDIT_LOG_FILE). The
# path below matches the packaged systemd unit:
#   - user:group = unifimcp:unifimcp (systemd StateDirectory=unifimcp)
#   - path = /var/lib/unifimcp/audit.jsonl (writable under ProtectSystem=strict)
# Adjust paths/retention to your policy.
#
# rename-mode rotation is used:
#   The server holds a single long-lived append (O_APPEND) file descriptor for
#   the audit sink and reopens it on SIGHUP. This enables lossless rotation
#   (rename + signal) without data loss. The server implements sighup reload
#   that calls reopen() on the audit file handle.
#
#   When receiving SIGHUP after renaming the audit file:
#   1. The server closes its old file descriptor
#   2. It reopens the same path, getting a new inodefd
#   3. Subsequent writes go to the new, empty file
#   4. The rotated file (audit.jsonl.1, audit.jsonl.2, etc.) is preserved intact
#
#   This is superior to copytruncate mode, which has an inherent race window
#   where audit events written between copy and truncate can be lost.
#
#   The postrotate script below is what actually delivers that signal --
#   without it, rotation renames the file out from under the server and the
#   new audit.jsonl stays empty forever: notifempty then skips every later
#   rotation, and the renamed file grows without bound while the server
#   believes it is still auditing.
#
#   The same SIGHUP also reloads the controller inventory and token store, so
#   rotation triggers those reloads too. That is benign: a failed reload logs
#   a warning and keeps the previous configuration rather than restarting.

/var/lib/unifimcp/audit.jsonl {
    daily
    rotate 14
    maxsize 100M
    missingok
    notifempty
    compress
    delaycompress
    create 0600 unifimcp unifimcp
    sharedscripts
    postrotate
        systemctl kill --kill-whom=main --signal=HUP rustunifimcp.service
    endscript
}
